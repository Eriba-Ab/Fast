# Copy to deploy/.env on the VPS and fill in. Never commit the real .env, and never
# send these values by chat or email: type them directly on the server.

# The public address. DNS for this name must point at the VPS.
SITE_DOMAIN=taraba.govpayhub.com
PUBLIC_BASE_URL=https://taraba.govpayhub.com

# Long random values (letters and digits only). Generate each with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=

# Go-live gate. Keep false until there is a dataset with real outstanding balances
# AND live Monnify credentials AND a successful live test payment.
PAYMENTS_ENABLED=false

# Monnify: sandbox first. Keys come from the Monnify dashboard:
#   Developers > API Keys & Contracts (sandbox and live keys are different).
MONNIFY_ENV=sandbox
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# Only if Monnify confirms production webhooks are signed with a key other than
# the Secret Key above:
# MONNIFY_WEBHOOK_SECRET=

# Staff sign-in cookies are HTTPS-only. Leave true on the VPS.
COOKIE_SECURE=true
SESSION_HOURS=10
